# Copy to .env and fill in real values. Never commit .env.
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/aromaspice_ui_system
# Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-hex-string
JWT_EXPIRES=12h
FRONTEND_ORIGIN=http://localhost:3000

# --- Phase B: payments (RAZORPAY TEST/SANDBOX KEYS ONLY — never production) ---
# Leave RAZORPAY_KEY_ID/RAZORPAY_SECRET empty to run the built-in local sandbox
# simulator (identical signature contract, no real money, no external calls).
# Get test-mode keys from dashboard.razorpay.com → Settings → API Keys (test mode).
PAYMENT_MODE=                     # razorpay (default when keys present) | sandbox
RAZORPAY_KEY_ID=                  # e.g. rzp_test_xxxxxxxxxxxx  (TEST key only)
RAZORPAY_SECRET=                  # test secret — server-side only, never sent to browser
RAZORPAY_WEBHOOK_SECRET=          # webhook signing secret from Razorpay dashboard
# Test-only HMAC secret for the built-in sandbox simulator (NOT a gateway credential):
PAYMENT_MOCK_SECRET=              # generate: openssl rand -hex 32
PAYMENT_PENDING_TTL_MIN=30        # pending payments older than this release their stock
